  <worksheets>
    <worksheet name="Model accuracy - test">
      <table>
        <view>
          <datasources>
            <datasource name="metropredict1" caption="Model accuracy - test"/>
          </datasources>
          <datasource-dependencies datasource="metropredict1">
            <column name="[Model]" datatype="string" role="dimension" type="nominal"/>
            <column name="[Precision at 8]" datatype="real" role="measure" type="quantitative" default-format="0.0%"/>
            <column-instance column="[Model]" derivation="None" name="[none:Model:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Precision at 8]" derivation="Sum" name="[sum:Precision at 8:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <computed-sort column="[metropredict1].[none:Model:nk]" direction="DESC" using="[metropredict1].[sum:Precision at 8:qk]"/>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <text column="[metropredict1].[sum:Precision at 8:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#147D92"/>
                <format attr="mark-labels-show" value="true"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[metropredict1].[none:Model:nk]</rows>
        <cols>[metropredict1].[sum:Precision at 8:qk]</cols>
      </table>
      <simple-id uuid="{6D32F5EC-05F1-55A4-8021-47239B6F94F0}"/>
    </worksheet>

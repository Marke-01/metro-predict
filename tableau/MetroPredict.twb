<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" original-version="26.1" version="26.1" source-build="0.0.0 (0000.0.0.0)" source-platform="win">
  <document-format-change-manifest>
    <ManifestByVersion/>
  </document-format-change-manifest>
  <datasources>
    <datasource caption="Model accuracy - test" inline="true" name="metropredict1" version="26.1">
      <connection class="textscan" directory="Data" filename="view_1.csv" separator="," header="yes" ignore-first="0" locale="en_US" text-qualifier="&quot;" character-set="utf-8">
        <relation name="view_1.csv" table="[view_1.csv]" type="table">
          <columns header="yes" separator="," character-set="UTF-8" locale="en_US">
            <column name="Model" datatype="string" ordinal="0"/>
            <column name="Precision at 8" datatype="real" ordinal="1"/>
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>Model</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Model]</local-name>
            <parent-name>[view_1.csv]</parent-name>
            <remote-alias>Model</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>Precision at 8</remote-name>
            <remote-type>5</remote-type>
            <local-name>[Precision at 8]</local-name>
            <parent-name>[view_1.csv]</parent-name>
            <remote-alias>Precision at 8</remote-alias>
            <ordinal>1</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <column name="[Model]" datatype="string" role="dimension" type="nominal"/>
      <column name="[Precision at 8]" datatype="real" role="measure" type="quantitative" default-format="0.0%"/>
    </datasource>
